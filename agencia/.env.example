# Copie este arquivo para ".env" (mesma pasta) e preencha com seus valores.
# O .env nao e versionado (ver .gitignore).

# URL AMQP da sua instancia de RabbitMQ. Para desenvolvimento local via
# Docker: amqp://guest:guest@localhost:5672/
# Para producao (CloudAMQP): amqps://usuario:senha@host.cloudamqp.com/vhost
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Segredos de autenticacao - troque por valores proprios antes de expor o
# sistema fora do ambiente de desenvolvimento.
ICEI_JWT_SECRET=dev-secret-troque-em-producao-tamanho-minimo-32-bytes
ICEI_JWT_EXPIRE_MINUTES=30
ICEI_INTERNAL_SECRET=dev-internal-secret-troque-em-producao

# Limite abaixo do qual a agencia publica um alerta de saldo baixo
# (funcionalidade adicional).
ICEI_SALDO_BAIXO_LIMITE=50
